# VCS / CI / deployment plumbing, not needed inside the build context
.git
.github
.dockerignore
Dockerfile
# Excludes the top-level ./docker/ tree from the root build context only.
# The meow wrapper image builds with its own context (./docker/meow),
# so removing this line is also safe today; keep it for clarity and to
# prevent a future shared/ subdir from leaking into the fumox image.
docker
scripts

# Local secrets and agent workspace notes
.env
.env.example
.agents
.zcode
.mimosa
.idea
.vscode
.DS_Store

# Local tool/agent scratch dirs and review output. None of these reach the
# image, but every unexcluded file is still transferred into the build
# context and re-COPYed on each source change; gui-test-screenshots alone is
# ~7 MB of PNGs.
audit-context
anti-slop
.rust-review-results
gui-test-screenshots
out
.cargo

# Compose/CLI tooling, not build inputs
docker-compose.yml
cliff.toml

# Local build artifacts and databases
target
*.db
*.db-wal
*.db-shm

# Docs and parser fixtures (may contain non-public data), irrelevant to the build
docs
test*.txt
*.md

# Local runtime config: GeoLite2 binaries are gitignored large files and
# the runtime app.toml may carry secrets. Mount them into /app/config at run
# time instead. The reference config/app.toml is the exception, it is
# `include_str!`-embedded by crates/fumox-core/src/config_writer.rs to back
# the admin panel's *Create from defaults* button, so it MUST be in the
# build context (the runtime /app/config/app.toml at run time is a separate
# file the operator owns).
config/*
!config/app.toml
