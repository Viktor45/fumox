# Copy to `.env` and adjust. docker compose reads `.env` automatically

# Admin panel login token (required by docker-compose, the panel is disabled
# without it). Generate a random one, do not reuse the placeholder:
#   printf 'FUMOX_ADMIN__TOKEN=%s\n' "$(openssl rand -hex 32)"
FUMOX_ADMIN__TOKEN=

# meow-rs external-controller secret (required by docker-compose, the proxy
# kernel refuses to start without it: the controller can rewrite the kernel's
# config; the probe sends it as `Authorization: Bearer <token>`).
# Only letters, digits, dot, underscore and dash are accepted. Generate:
#   printf 'FUMOX_MEOW__API_TOKEN=%s\n' "$(openssl rand -hex 32)"
FUMOX_MEOW__API_TOKEN=

# Optional: TOML config file inside the containers. Both services load from
# the ./config volume mount; the default equals what the image does on its
# own. The file must exist, a missing one fails startup loudly
#FUMOX_CONFIG=/app/config/app.toml

# Optional: mount mode for the ./config volume in the server container.
# `ro` turns the admin *Edit settings* page into a read-only view (the probe
# container is always read-only). Default: rw
#FUMOX_CONFIG_ACCESS=rw

# Optional: host ports of the published listeners. Defaults: 8080 public,
# 8081 admin (loopback-only). scripts/smoke-up.sh shifts them for an isolated
# second stand under the "fumox-smoke" compose project
#FUMOX_PUBLIC_PORT=8080
#FUMOX_ADMIN_PORT=8081
#FUMOX_ADMIN_BIND=127.0.0.1

# Optional: T2 delay-test URL(s), one drawn per probe cycle. Override when
# the default Google endpoint is blocked in your region; comma-separated for
# several. HTTPS only: a plain-HTTP answer does not prove a tunnel is up
#FUMOX_MEOW__TEST_URL=https://www.gstatic.com/generate_204

# Optional: allow source URLs pointing at private/loopback addresses
# (disables SSRF protection). Local testing only. Default: false
#FUMOX_ADMIN__ALLOW_PRIVATE_URLS=true

# Optional: let the probe dial loopback/RFC1918/link-local/CGNAT targets from
# feeds (disables the probe-side SSRF guard). Local testing only, feeds are
# untrusted input. Default: false
#FUMOX_PROBE__ALLOW_PRIVATE_TARGETS=true

# Optional: add `; Secure` to the admin session cookie. Browsers drop Secure
# cookies on plain HTTP, so a localhost panel needs false, an HTTPS front
# needs true. config/app.toml defaults to false, but docker-compose.yml
# defaults this ENV to true (an empty value or a removed line does not help,
# compose substitutes true), so a plain-HTTP compose deployment must set
# FUMOX_ADMIN__SECURE_COOKIES=false in .env
#FUMOX_ADMIN__SECURE_COOKIES=false

# Optional: docker build strategy for `docker compose build` (the Dockerfile
# BUILD_CACHE arg). `mounts` (default) caches the cargo registry + target dir
# in BuildKit cache mounts, so a source-only change recompiles just the
# workspace crates (~1 min instead of ~7.5) and compiles with LTO off and 16
# codegen units; `layers` is classic cargo-chef layer caching for builders
# without cache-mount support (podman-compose etc.), CI's published image
# path stays on `layers` with the optimized profile
#FUMOX_BUILD_CACHE=mounts

# Optional: meow-rs release the wrapper image wraps (docker/meow/Dockerfile).
# The version and the two musl-archive SHA256 sums are pinned together, the
# build refuses a download whose hash does not match; bump them in the same
# edit (docker-compose.build.yml carries the defaults). Local builds only:
# the GHCR image (ghcr.io/viktor45/fumox-meow) is packaged by the manual
# .github/workflows/docker-meow.yml workflow
#MEOW_VERSION=v0.29.0
#MEOW_SHA256_AMD64=92fe902cca5e95799af02a42fcda9a4f9195aa61ec126057b51b15a8d2116ca2
#MEOW_SHA256_ARM64=6fa37f13ddeaafae605e65bc9f2ab0c538b9ab3fad11c8b12180f0a52b4c06b7

# Optional: the images the stack runs. The docker-compose.yml defaults are
# digests, one immutable manifest per image, so a deployment cannot change
# under a running stack. Point them at another digest or at a local tag built
# with docker-compose.build.yml:
#   docker buildx imagetools inspect ghcr.io/viktor45/fumox:latest
#FUMOX_IMAGE=ghcr.io/viktor45/fumox:latest
#FUMOX_MEOW_IMAGE=ghcr.io/viktor45/fumox-meow:latest
