# Copy to `.env` and adjust. docker compose reads `.env` automatically.

# Admin panel login token (required by docker-compose; the panel is disabled
# without it). Generate a random one, do not reuse the placeholder:
#   printf 'FUMOX_ADMIN__TOKEN=%s\n' "$(openssl rand -hex 32)"
FUMOX_ADMIN__TOKEN=

# Secret of the meow-rs external-controller (required by docker-compose; the
# proxy kernel refuses to start without it, because the controller can
# rewrite the kernel's configuration). The probe presents it as
# `Authorization: Bearer <token>`. Generate a random one:
#   printf 'FUMOX_MEOW__API_TOKEN=%s\n' "$(openssl rand -hex 32)"
# Only letters, digits, dot, underscore and dash are accepted.
FUMOX_MEOW__API_TOKEN=

# Optional: TOML config file inside the containers. Both services point the
# loader at the ./config volume mount (see docker-compose.yml); the default
# below reads ./config/app.toml, exactly what the image does on its own.
# Override with another file name in that volume (e.g. /app/config/prod.toml)
#, the file must exist, a missing one fails the startup loudly.
#FUMOX_CONFIG=/app/config/app.toml

# Optional: mount mode for the ./config volume in the server container.
# `ro` turns the admin *Edit settings* page into a read-only view (the
# probe container is always read-only). Default: rw.
#FUMOX_CONFIG_ACCESS=rw

# Optional: host ports for the published listeners. Defaults: 8080 (public)
# and 8081 (admin, loopback-only). Shift them to run a second, isolated stand
# next to the main one, scripts/smoke-up.sh does exactly that under the
# "fumox-smoke" compose project.
#FUMOX_PUBLIC_PORT=8080
#FUMOX_ADMIN_PORT=8081
#FUMOX_ADMIN_BIND=127.0.0.1

# Optional: T2 delay-test URL(s). The probe draws one of them per cycle and
# every check of that cycle hits it. The default is a single Google
# endpoint; override with a URL of your own (or several comma-separated
# ones) if it is blocked in your region. Use HTTPS only: a plain-HTTP
# answer does not prove that a tunnel is up.
#FUMOX_MEOW__TEST_URL=https://www.gstatic.com/generate_204

# Optional: allow source URLs pointing at private/loopback addresses
# (disables SSRF protection). Local testing only. Default: false.
#FUMOX_ADMIN__ALLOW_PRIVATE_URLS=true

# Optional: let the probe dial loopback/RFC1918/link-local/CGNAT targets
# harvested from feeds (disables the probe-side SSRF guard). Local testing
# only, feeds are untrusted input. Default: false.
#FUMOX_PROBE__ALLOW_PRIVATE_TARGETS=true

# Optional: add `; Secure` to the admin session cookie. Browsers drop
# Secure cookies on plain HTTP, so a localhost deployment that opens the
# panel at http://127.0.0.1:8081 must set it to false, otherwise the
# cookie is rejected on every login and the panel keeps redirecting back
# to /admin/login even though the server logs `admin logged in`. Set true
# when the panel is reached through an HTTPS front (reverse proxy with
# TLS). config/app.toml defaults to false, but docker-compose.yml
# defaults this ENV to true, so a plain-HTTP compose deployment must
# set FUMOX_ADMIN__SECURE_COOKIES=false in .env (an empty value or
# removing the line does not help — compose substitutes true).
#FUMOX_ADMIN__SECURE_COOKIES=false

# Optional: docker build strategy for `docker compose build` (the Dockerfile
# BUILD_CACHE arg). `mounts` (default) caches the cargo registry + target dir
# in persistent BuildKit cache mounts, so a source-only change recompiles
# just the workspace crates (~1 min instead of ~7.5); `layers` is the
# classic cargo-chef layer caching for builders without cache-mount support
# (podman-compose etc.). `mounts` also compiles with LTO off and 16 codegen
# units (faster rebuilds, slightly slower binaries); the published image
# path used by CI stays on `layers` and keeps the optimized profile.
#FUMOX_BUILD_CACHE=mounts

# Optional: meow-rs release the wrapper image wraps (docker/meow/Dockerfile).
# The release is pinned: the version below and the two SHA256 sums of its
# musl archives travel together, and the build refuses a download whose
# hash does not match. Bumping the version means bumping the sums in the
# same edit (docker-compose.build.yml carries the defaults), so a new
# upstream release is picked up through review, not by accident.
# Local builds only: the GHCR image (ghcr.io/viktor45/fumox-meow) is
# packaged separately by the manual .github/workflows/docker-meow.yml
# workflow.
#MEOW_VERSION=v0.29.0
#MEOW_SHA256_AMD64=92fe902cca5e95799af02a42fcda9a4f9195aa61ec126057b51b15a8d2116ca2
#MEOW_SHA256_ARM64=6fa37f13ddeaafae605e65bc9f2ab0c538b9ab3fad11c8b12180f0a52b4c06b7

# Optional: the images the stack runs. The defaults in docker-compose.yml
# are digests: one immutable manifest per image, so a deployment cannot
# change under a running stack. Point them at another digest (or at a
# local tag built with docker-compose.build.yml) to move the stack:
#   docker buildx imagetools inspect ghcr.io/viktor45/fumox:latest
#FUMOX_IMAGE=ghcr.io/viktor45/fumox@sha256:6490bda1a14b3ce12b5192121cfb92ffca220761a732661f4bd2a79d8373f466
#FUMOX_MEOW_IMAGE=ghcr.io/viktor45/fumox-meow@sha256:49e91fa751672db22916982ed4cb97423d7aaaa667cf4984e973f613f2406e7b
