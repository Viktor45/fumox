# Fumox TLS front: the server blocks.
#
# Rendered by the nginx image's entrypoint from
# /etc/nginx/templates/default.conf.template into
# /etc/nginx/conf.d/default.conf. The ${...} placeholders are replaced
# with the environment variables of the container:
#
#   FUMOX_UPSTREAM_PUBLIC   the public listener (default server:8080)
#   FUMOX_UPSTREAM_ADMIN    the admin panel     (default server:8081)
#   FUMOX_SERVER_NAME       the canonical name  (default fumox.example.com)
#
# See nginx.conf for the compose / podman flavour notes.
#
# The front writes the X-Forwarded-* family (For, Proto), so the server
# side needs [server].trust_proxy_ips (the CIDR of this container's
# network) and [server].trust_proxy_header = "xff" (the family written
# here) for both listeners, plus [server].allowed_hosts /
# [admin].allowed_hosts with the canonical name above. Without them the
# per-IP rate limit counts this proxy's IP, the links stay on http behind
# the TLS front, and the Host header is trusted as-is.

# The Host forwarded upstream and used as the target of the :80
# redirect. The client's Host is normalised: the default ports (80/443)
# are dropped, a non-default port is kept (a NAT'd port mapping — the
# smoke stand, a reverse proxy published on 8443 — needs it in the
# links), and a Host that is not a plain hostname is replaced by the
# canonical name, so a crafted Host cannot end up in a link.
#
# A well-formed but foreign hostname ("evil.example.com") is passed
# through unchanged: the front does not know which names the deployment
# serves. Fumox decides that — [server].allowed_hosts
# (FUMOX_SERVER__ALLOWED_HOSTS) rejects a request whose Host is not on
# the list, and the serve links it builds carry the host of the
# request.
map $http_host $fumox_host {
    "~^(?<fhost>[A-Za-z0-9._-]+):80$"                     $fhost;
    "~^(?<fhost>[A-Za-z0-9._-]+):443$"                    $fhost;
    "~^(?<fhost>[A-Za-z0-9._-]+):(?<fport>[0-9]{1,5})$"   $fhost:$fport;
    "~^(?<fhost>[A-Za-z0-9._-]+)$"                        $fhost;
    default                                                $server_name;
}

server {
    listen 80;
    server_name _;

    # Relative Location: the browser keeps the scheme/host/port it
    # connected on (a NAT'd port mapping or the smoke stand's shifted
    # port survives; production 443 needs nothing extra).
    absolute_redirect off;

    # certbot writes its challenge files here (webroot mode).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$fumox_host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${FUMOX_SERVER_NAME};   # your domain, or "_" for a bare IP

    # Mounted at runtime (see the Dockerfile header); reload with
    # `docker kill -s HUP <nginx-container>` after renewal.
    ssl_certificate     /certs/fullchain.pem;
    ssl_certificate_key /certs/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Same rationale as on the :80 server: the admin panel may sit
    # behind a port mapping, keep the browser on its own port.
    absolute_redirect off;

    # ---- admin panel (the admin listener) ------------------------------
    # The SSE stream first: /admin/events is an exact match and keeps
    # its own (long) timeouts, the panel's pages below answer in
    # seconds.
    location = /admin/events {
        set $fumox_admin http://${FUMOX_UPSTREAM_ADMIN};
        proxy_pass $fumox_admin;

        proxy_set_header Host $fumox_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A live SSE stream: buffering would delay every dashboard
        # update to the proxy buffer timeout, and the stream stays open
        # until the browser goes away.
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Everything else /admin: the panel, its static assets, the forms.
    location /admin {
        set $fumox_admin http://${FUMOX_UPSTREAM_ADMIN};
        proxy_pass $fumox_admin;

        proxy_set_header Host $fumox_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The panel's pages are small and answer in milliseconds: a
        # stuck request must not hold a worker for minutes.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # ---- public subscriptions (the public listener) ---------------------
    # /sub/{id}, /src/{slug}, /export/alive/{token}, /export/ready/{token}
    # and /healthz.
    location / {
        # The URIs here carry the export tokens: they are bearer
        # credentials, and access_log masks them through $fumox_safe_uri
        # (see nginx.conf). error_log has no format control — its [error]
        # lines (upstream failures, oversized headers) embed the raw
        # request line verbatim — so this location raises its level to
        # crit: request-carrying error lines are dropped, while the admin
        # locations below keep full diagnostics and genuine crit/emerg
        # conditions still land in the error log.
        error_log /var/log/nginx/error.log crit;

        set $fumox_public http://${FUMOX_UPSTREAM_PUBLIC};
        proxy_pass $fumox_public;

        proxy_set_header Host $fumox_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A client stuck on a slow proxy link must not hold a worker
        # forever; Fumox answers subscriptions from cache, fast.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering on;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
