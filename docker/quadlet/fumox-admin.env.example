# Copy to ~/.config/fumox/fumox-admin.env and adjust. ONLY the server
# container reads this file (fumox-server.container); the probe and the
# kernel never see it, so a defect in the probe cannot reach the admin
# panel. After editing it:
#
#   systemctl --user daemon-reload
#   systemctl --user restart fumox-server.service
#
# The file holds the panel's login token, so it must not be readable by
# other users: mode 600, owner = you.
#
#   mkdir -p ~/.config/fumox
#   install -m 600 docker/quadlet/fumox-admin.env.example ~/.config/fumox/fumox-admin.env

# Admin panel login token (required, the panel is disabled without it).
# Generate a random value — do not reuse a placeholder:
#
#   printf 'FUMOX_ADMIN__TOKEN=%s\n' "$(openssl rand -hex 32)"
#
# and paste the result below. The server refuses to start with the old
# `change-me` placeholder, and an empty value disables the panel.
FUMOX_ADMIN__TOKEN=

# Optional: add `; Secure` to the admin session cookie. Browsers drop
# Secure cookies on plain HTTP, so a deployment that opens the panel at
# http://127.0.0.1:8081 must leave this false, otherwise the cookie is
# rejected on every login and the panel keeps redirecting back to
# /admin/login even though the server logs `admin logged in`. Set true
# when the panel is reached through an HTTPS front (reverse proxy with
# TLS). config/app.toml defaults to false.
#FUMOX_ADMIN__SECURE_COOKIES=false

# Optional: allow source URLs pointing at private/loopback addresses
# (disables SSRF protection). Local testing only. Default: false.
#FUMOX_ADMIN__ALLOW_PRIVATE_URLS=true
