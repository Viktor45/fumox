# meow-rs, mihomo-compatible kernel the probe drives for T2 checks.
# The image renders its config from the template at startup (the
# entrypoint), the CMD is baked in.
#
# The image is pinned by digest (the same manifest docker-compose.yml pins),
# so a start cannot silently move to different bytes: a tag is a mutable
# pointer and proves nothing about integrity. For local development and
# building from source, edit this line to a locally built tag instead
# (localhost/fumox-meow:local; podman build -t localhost/fumox-meow:local
# docker/meow) — and back to a digest afterwards, see docker/README.md.
#
# The controller answers only to a caller that presents the secret from
# FUMOX_MEOW__API_TOKEN (the entrypoint refuses to start without one),
# and it listens on the pod loopback (127.0.0.1:9090): no other pod, no
# other container and nothing on the host can reach it.

[Unit]
Description=meow-rs kernel for T2 checks (REST API 9090, pod-internal)

[Container]
Image=ghcr.io/viktor45/fumox-meow@sha256:49e91fa751672db22916982ed4cb97423d7aaaa667cf4984e973f613f2406e7b
ContainerName=fumox-meow
Pod=fumox-worker.pod

# The image runs as this user (uid 998, gid 999): the kernel reads the
# generated config through the shared group and must not be able to open
# the SQLite database, which the probe writes under uid 999.
User=998
Group=999
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
# The rendered config (it carries the controller secret) and the kernel's
# data directory live on RAM only.
Tmpfs=/run/meow:rw,noexec,nosuid,nodev,mode=1777,size=16m

# The controller secret and the shared runtime variables.
EnvironmentFile=%h/.config/fumox/fumox.env

# The probe shares the pod's network namespace, so the controller can
# stay on the loopback address: nothing outside this pod reaches it.
Environment=FUMOX_MEOW_API_BIND=127.0.0.1:9090

Volume=fumox-meow.volume:/shared/meow

# Liveness: the external-controller (the one port the probe drives) must
# answer on the pod loopback. A plain TCP connect via bash's /dev/tcp: the
# image ships no curl, and the controller secret is checked per-request by
# the kernel itself, not by the probe.
HealthCmd=bash -c "exec 3<>/dev/tcp/127.0.0.1/9090"
HealthInterval=10s
HealthTimeout=4s
HealthRetries=6
HealthStartPeriod=5s

[Service]
# Same policy as the other units: restart unless the operator stopped it,
# with a delay that throttles a crash loop.
Restart=always
RestartSec=5
MemoryMax=256M
CPUQuota=75%
TasksMax=128

[Install]
WantedBy=default.target
