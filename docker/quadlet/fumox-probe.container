# fumox-probe, health-check daemon (T1 TCP/TLS sample + T2 tunnel checks
# driven through the meow-rs REST API). Overrides the image CMD the same way
# compose `command: ["fumox-probe"]` does; tini stays as the entrypoint.
#
# The unit runs in the worker pod (fumox-worker.pod), next to the kernel
# it drives and away from the admin panel.

[Unit]
Description=Fumox probe (health checks: T1 TCP/TLS + T2 via meow)
# The server creates/migrates the DB first. The probe does not depend on
# it: both apply the schema on startup, SQLite serializes the two
# writers and the loser retries until the lock is free (see
# connect_probe_pool in crates/fumox-core/src/db.rs).
Wants=fumox-server.service
After=fumox-server.service

[Container]
Image=localhost/fumox:local
ContainerName=fumox-probe
Pod=fumox-worker.pod
Exec=fumox-probe

User=999
Group=999
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:rw,noexec,nosuid,nodev,mode=1777,size=64m

# The shared runtime variables only: the admin login token lives in
# fumox-admin.env, which the probe never reads.
EnvironmentFile=%h/.config/fumox/fumox.env

# One network namespace inside the pod: meow is reached on loopback, not by
# the compose DNS name "meow" (9090 is not published to the host).
# The config file pointer (FUMOX_CONFIG) is NOT fixed here on purpose: values
# in Environment= outrank the env file, and the operator may want to point it
# at a differently named file in the mounted config volume, see
# fumox.env.example. The image default (config/app.toml under /app) applies
# when the variable is unset.
Environment=FUMOX_MEOW__API_ADDR=127.0.0.1:9090
Environment=FUMOX_MEOW__CONFIG_PATH=/shared/meow/meow.yaml

# Probe only reads app.toml at startup, never writes. Read-only mount means
# a buggy probe can never mangle the config the server is also editing.
Volume=%h/fumox/config:/app/config:ro,z
Volume=fumox-data.volume:/app/data
Volume=fumox-meow.volume:/shared/meow

# The probe has no listener of its own, so there is nothing to HTTP-probe;
# what its work depends on is the kernel's controller answering on the pod
# loopback (see FUMOX_MEOW__API_ADDR above). The health check is a plain
# TCP connect (bash's /dev/tcp; the image ships no curl). It reports the
# pod's kernel as unreachable — the probe itself keeps running through
# meow outages (its own backoff), liveness of the process is systemd's
# Restart=always below.
HealthCmd=bash -c "exec 3<>/dev/tcp/127.0.0.1/9090"
HealthInterval=10s
HealthTimeout=4s
HealthRetries=6
HealthStartPeriod=15s

[Service]
# Same policy as the server unit: restart unless the operator stopped it,
# with a delay that throttles a crash loop.
Restart=always
RestartSec=5
# Smaller quota than the server: the probe only samples the proxy list.
MemoryMax=256M
CPUQuota=50%
TasksMax=128

[Install]
WantedBy=default.target
