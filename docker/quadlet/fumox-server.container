# fumox-server — public /sub + /src on :8080 (published by the pod) and the
# admin panel on :8081 (loopback-only). Default CMD of the image is already
# fumox-server, so no Exec= override is needed.
#
# Quadlet does not build images — prepare localhost/fumox:local before the
# first start: either pull+tag the GHCR image (see docker/README.md) or
#   podman build -t localhost/fumox:local .

[Unit]
Description=Fumox server (subscription endpoints + admin panel)

[Container]
Image=localhost/fumox:local
ContainerName=fumox-server
Pod=fumox.pod

# .env equivalent (see fumox.env.example); must exist before first start.
# Values here CANNOT be overridden from the env file — podman gives
# Environment= precedence over EnvironmentFile= — so only fixed wiring
# lives in the unit; anything an operator may want to change belongs in
# the env file.
EnvironmentFile=%h/.config/fumox/fumox.env

Environment=FUMOX_GEO__DB_DIR=/shared
# Config file inside the container: the default below is what the image
# uses anyway (config/app.toml relative to /app). Uncomment and adjust ONLY
# if the file in the mounted config volume has a different name (the file
# must exist — a missing one fails the startup loudly). Set it in the env
# file instead when you just want to override the default:
#   FUMOX_CONFIG=/app/config/app.toml
#Environment=FUMOX_CONFIG=/app/config/app.toml

# Left side: a directory with app.toml (and optional GeoLite2-*.mmdb).
# %h expands to your home dir; point it at the repo's config/ if you prefer.
Volume=%h/fumox/config:/app/config:ro,Z
Volume=fumox-data.volume:/app/data
Volume=fumox-shared.volume:/shared

[Service]
# systemd equivalent of compose "restart: unless-stopped".
Restart=on-failure

[Install]
WantedBy=default.target
